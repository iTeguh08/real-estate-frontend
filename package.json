{
  "name": "real-estate-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/dev-guard.mjs",
    "dev": "next dev",
    "dev:fresh": "node scripts/kill-dev.mjs && rm -rf .next && next dev",
    "build": "next build",
    "build:prod": "node scripts/build-prod.mjs",
    "deploy:vps": "bash scripts/deploy.sh",
    "start": "next start",
    "dev:vite": "vite",
    "build:vite": "tsc -p tsconfig.app.json && vite build && cp dist/index.html dist/404.html",
    "optimize:hero": "node scripts/optimize-hero.mjs",
    "optimize:bg": "node scripts/optimize-bg.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.7",
    "@hookform/resolvers": "^5.7.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "^3.18.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "next": "^15.5.23",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.85.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1",
    "shadcn": "^4.11.0",
