# ---------------------------------------------------------------------------
# Local development (Vite dev server + Laravel Sail on :8080)
# ---------------------------------------------------------------------------
VITE_USE_MOCK=false

# GraphQL — absolute URL in dev (Vite does not proxy /graphql by default)
VITE_GRAPHQL_URL=http://localhost:8080/graphql

# REST forms — leave empty in dev; Vite proxies these paths to :8080
# VITE_API_URL=

# Sentry — leave empty locally (no-op). Set DSN in production host / CI secrets.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Next.js Pages Router — local (`npm run dev` / copy into `.env.local`)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_USE_MOCK=false
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql
# NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Production Next — prefer `npm run build:prod` (forces these over `.env.local`)
# Relative GraphQL works in the browser; SSR prefixes INTERNAL_BACKEND_ORIGIN.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_USE_MOCK=false
# NEXT_PUBLIC_GRAPHQL_URL=/graphql
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SITE_URL=https://baliestate.web.id
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1
# INTERNAL_BACKEND_ORIGIN=http://127.0.0.1
#
# Vite static (legacy):
# VITE_USE_MOCK=false
# VITE_GRAPHQL_URL=/graphql
# VITE_API_URL=
