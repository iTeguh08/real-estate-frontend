# ---------------------------------------------------------------------------
# Local development (Vite dev server + Laravel Sail on :8080)
# ---------------------------------------------------------------------------
VITE_USE_MOCK=false

# GraphQL — absolute URL in dev (Vite does not proxy /graphql by default)
VITE_GRAPHQL_URL=http://localhost:8080/graphql

# REST forms — leave empty in dev; Vite proxies these paths to :8080
# VITE_API_URL=

# Sentry — leave empty locally (no-op). Set DSN in production host / CI secrets.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Production (static build: npm run build)
# ---------------------------------------------------------------------------
# VITE_USE_MOCK=false
#
# Option A — separate API subdomain (cross-origin, requires backend CORS + SESSION_SAME_SITE=none)
# VITE_GRAPHQL_URL=https://api.homzen.com/graphql
# VITE_API_URL=https://api.homzen.com
#
# Option B — same origin via reverse proxy (recommended; use relative paths)
# VITE_GRAPHQL_URL=/graphql
# VITE_API_URL=
#
# VITE_SENTRY_DSN=https://...@o....ingest.sentry.io/...
# VITE_SENTRY_ENVIRONMENT=production
